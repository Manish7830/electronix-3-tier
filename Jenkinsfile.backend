pipeline {
    agent {
        label 'electronix'
    }

    environment {
        ECR_REPO     = '875285643684.dkr.ecr.us-east-1.amazonaws.com/electronix-ecr'
        AWS_REGION   = 'us-east-1'
        PRODUCTION_IP = '100.50.251.153'
    }

    stages {

        stage('Build Docker Image') {
            steps {
                dir('backend') {
                    sh '''
                    sudo docker build -t electronix-backend:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                sudo aws ecr get-login-password --region ${AWS_REGION} | sudo docker login --username AWS --password-stdin ${ECR_REPO}
                '''
            }
        }

        stage('Tag and Push Docker image') {
            steps {
                sh '''
                sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:latest

                sudo docker push ${ECR_REPO}:${BUILD_NUMBER}
                sudo docker push ${ECR_REPO}:latest

                echo "Pushed Successfully ✅"
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully ✅"
        }

        failure {
            echo "Pipeline failed ❌"
        }
    }
}